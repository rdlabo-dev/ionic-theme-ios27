{
  "name": "ionic-theme-workspace",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run docgen && npm run build -w @rdlabo/capacitor-native-ui && npm run build -w @rdlabo/ionic-theme-ios27",
    "docgen": "npm run docgen -w @rdlabo/capacitor-native-ui",
    "build:css": "npm run build:css -w @rdlabo/ionic-theme-ios27",
    "build:ts": "npm run build -w @rdlabo/capacitor-native-ui && npm run build:ts -w @rdlabo/ionic-theme-ios27",
    "build:demo": "npm run build && npm --prefix demo run build -- --configuration=production",
    "lint": "prettier --check \"./**/*.{scss,ts}\" && prettier --parser angular --check \"./**/*.html\"",
    "fmt": "prettier --write \"./**/*.{scss,ts}\" && prettier --parser angular --write \"./**/*.html\"",
    "test:esm": "node scripts/verify-packages.mjs --esm",
    "pack:packages": "node scripts/pack-packages.mjs",
    "test:packages": "node scripts/verify-packages.mjs --candidate"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.2",
    "@ionic/angular": "^9.0.0",
    "@rdlabo/capacitor-docgen": "^0.4.1",
    "@rdlabo/ionic-theme-utils": "0.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.1",
    "np": "^10.2.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/rdlabo-dev/ionic-theme-ios27.git"
  }
}
