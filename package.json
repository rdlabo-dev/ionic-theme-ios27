{
  "name": "@rdlabo/ionic-theme-ios26",
  "private": false,
  "version": "9.2.0",
  "description": "iOS26 Theme for Ionic Framework",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/css/*": "./dist/css/*",
    "./src/styles/*": "./src/styles/*"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "docs"
  ],
  "scripts": {
    "build": "npm run build:css && npm run build:ts",
    "build:css": "rm -rf dist/css && sass src/styles:dist/css --style=compressed --no-source-map --pkg-importer=node",
    "build:ts": "tsc",
    "build:demo": "npm run build && cd demo && npm install && npm run build -- --configuration=production",
    "lint": "prettier --check \"./**/*.{scss,ts}\" &&  prettier --parser angular --check \"./**/*.html\"",
    "fmt": "prettier --write \"./**/*.{scss,ts}\" &&  prettier --parser angular --write \"./**/*.html\"",
    "release": "np --branch ios26 --no-tests --no-publish",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/rdlabo-dev/ionic-theme-ios27.git"
  },
  "keywords": [
    "ionic",
    "framework",
    "theme",
    "css",
    "ios26"
  ],
  "author": "Masahiko Sakakibara <sakakibara@rdlabo.jp>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rdlabo-dev/ionic-theme-ios27/issues"
  },
  "homepage": "https://docs.rdlabo.dev/projects/ionic-theme-ios26",
  "dependencies": {
    "@rdlabo/ionic-theme-utils": "git+ssh://git@github.com/rdlabo-dev/ionic-theme-utils.git#main"
  },
  "devDependencies": {
    "@ionic/angular": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.1",
    "np": "^10.2.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  },
  "peerDependencies": {
    "@ionic/core": ">=8.8.1 <10"
  }
}
