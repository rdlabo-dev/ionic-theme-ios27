{
  "name": "@rdlabo/ionic-theme-ios27",
  "private": false,
  "version": "0.2.0",
  "description": "iOS27 Theme for Ionic Framework",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/css/*": "./dist/css/*",
    "./src/styles/*": "./src/styles/*",
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "docs",
    "ios",
    "Package.swift"
  ],
  "scripts": {
    "build": "npm run docgen && npm run build:css && npm run build:ts",
    "build:css": "rm -rf dist/css && sass src/styles:dist/css --style=compressed --no-source-map --pkg-importer=node",
    "build:ts": "tsc",
    "docgen": "docgen --project tsconfig.docgen.json --api NativeUIShellHandle --output-readme docs/native-ui-shell.md",
    "build:demo": "npm run build && cd demo && npm install && npm run build -- --configuration=production",
    "lint": "prettier --check \"./**/*.{scss,ts}\" &&  prettier --parser angular --check \"./**/*.html\"",
    "fmt": "prettier --write \"./**/*.{scss,ts}\" &&  prettier --parser angular --write \"./**/*.html\"",
    "release": "np --no-tests --no-publish",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/rdlabo-dev/ionic-theme-ios27.git"
  },
  "keywords": [
    "ionic",
    "framework",
    "theme",
    "css",
    "ios27"
  ],
  "author": "Masahiko Sakakibara <sakakibara@rdlabo.jp>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rdlabo-dev/ionic-theme-ios27/issues"
  },
  "homepage": "https://docs.rdlabo.dev/projects/ionic-theme-ios27",
  "dependencies": {
    "@rdlabo/ionic-theme-utils": "git+ssh://git@github.com/rdlabo-dev/ionic-theme-utils.git#66eb2fccca10646ebfccdfb3b6c2f3b4c9b00bf6"
  },
  "devDependencies": {
    "@capacitor/core": "^8.5.2",
    "@ionic/angular": "^9.0.0",
    "@rdlabo/capacitor-docgen": "^0.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.1",
    "np": "^10.2.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  },
  "peerDependencies": {
    "@ionic/core": ">=8.8.1 <10",
    "@capacitor/core": ">=8.0.0 <9"
  },
  "peerDependenciesMeta": {
    "@capacitor/core": {
      "optional": true
    }
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    }
  }
}
