{
  "name": "@rdlabo/ionic-theme-ios27",
  "private": false,
  "version": "1.2.1",
  "description": "iOS27 Theme for Ionic Framework",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/css/*": "./dist/css/*",
    "./src/styles/*": "./src/styles/*"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "scripts": {
    "prebuild:css": "rdlabo-copy-structured-list src/styles/utils/structured-list.scss",
    "build:css": "rm -rf dist/css && sass src/styles:dist/css --style=compressed --no-source-map",
    "build:ts": "tsc --noEmit && rdlabo-build-theme",
    "build": "rm -rf dist && npm run build:css && npm run build:ts"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/rdlabo-dev/ionic-theme-ios27.git",
    "directory": "packages/theme-ios27"
  },
  "keywords": [
    "ionic",
    "framework",
    "theme",
    "css",
    "ios27"
  ],
  "author": "Masahiko Sakakibara <sakakibara@rdlabo.jp>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rdlabo-dev/ionic-theme-ios27/issues"
  },
  "homepage": "https://docs.rdlabo.dev/projects/ionic-theme-ios27",
  "dependencies": {
    "@rdlabo/ionic-theme-utils": "0.1.4",
    "ionicons": "^8.1.0",
    "@stencil/core": "^4.43.5"
  },
  "peerDependencies": {
    "@ionic/core": ">=8.8.1 <10"
  },
  "type": "module"
}
